# ==============================================================================
# ZAND AI SaaS Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Storage
# Defaults to in-memory in test mode, or local persistent JSON in development/production
DATABASE_FILE=./data/db.json

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# ------------------------------------------------------------------------------
# AI Provider Integration
# Supported providers: openai | anthropic | groq | gemini | openrouter | fallback
# When provider is 'fallback' or no API key is set, the deterministic generator is used
# ------------------------------------------------------------------------------
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# ------------------------------------------------------------------------------
# Image / Logo / Banner Generation
# Supported providers: openai | fallback
# When set to fallback or key absent, renders crisp high-res dynamic vector SVG assets
# ------------------------------------------------------------------------------
IMAGE_PROVIDER=fallback
IMAGE_API_KEY=

# ------------------------------------------------------------------------------
# Stripe Billing & Subscriptions
# Required for real payments in production.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_FOUNDER=price_founder_monthly
